# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas M0 free tier) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/homehub?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- MQTT (HiveMQ Cloud free tier or self-hosted Mosquitto) ---
MQTT_BROKER_URL=mqtts://<your-cluster-id>.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Firebase (FCM) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Webhook signing (for HTTP-only devices, Phase 2) ---
WEBHOOK_SIGNING_SECRET=replace_with_a_long_random_string

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000


# --- Stale-state sweep (Phase 3) ---
# How long a device can go without a message before it's demoted from 'online' to
# 'unknown' (not 'offline' — that's reserved for an explicit LWT/status message).
STALE_THRESHOLD_MS=600000